# OAuth client IDs from Google Cloud → Google Auth Platform → Clients.
# Public values (they ship inside the app), not secrets. Rebuild after changing.

# The "Web application" client. Required on every platform: Google issues the
# ID token for this client, and it's the first client ID listed in Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# The "iOS" client (bundle ID = your app's). Also used to derive the iOS URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-def456.apps.googleusercontent.com

# Android needs no ID in the app: Google matches the build by package name + SHA-1.
